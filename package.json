{
	"name": "@hasdata/n8n-nodes-hasdata",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"version": "1.0.1",
	"description": "n8n node for HasData APIs",
	"license": "MIT",
	"homepage": "https://hasdata.com",
	"keywords": [
		"n8n-community-node-package",
		"hasdata"
	],
	"author": {
		"name": "HasData",
		"email": "support@hasdata.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hasdata/n8n-nodes-hasdata.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"generate": "npx ts-node -T tools/generate-node-specs.ts",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/HasDataApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/HasData/HasData.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/js-yaml": "^4.0.9",
		"eslint": "9.32.0",
		"js-yaml": "^4.1.1",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}